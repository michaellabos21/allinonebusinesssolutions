# Copy to .env.local and fill in the values. Never commit .env.local.
# For the local stack, `npx supabase status` prints the URL and both keys.

# Supabase project URL and publishable (anon) key. Safe to expose to the browser:
# access is limited by row-level security, not by keeping these secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key. SERVER ONLY. It bypasses row-level security, so it must
# never be given a NEXT_PUBLIC_ name, imported into a client component, or
# logged. Used only by migrations, seed scripts and isolation tests.
SUPABASE_SERVICE_ROLE_KEY=

# Public origin of the app, used to build links in invitation emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Development and demo only. When "true", an empty workspace offers an
# "Add sample records" button that fills it with fictional contacts, projects
# and tasks. Leave unset anywhere real data lives.
ENABLE_SAMPLE_DATA=
